# ==============================================================
# OrangeApps RFID Kiosk - Environment Configuration Template
# ==============================================================

# 1. App Identity / Display Name:
APP_NAME=OrangeApps RFID Kiosk

# 2. Release Base URL:
# Examples:
#   RELEASE_BASE_URL=https://schooltesterp.orangeapps.ph/qr
#   RELEASE_BASE_URL=https://dominicanstarosaerp.orangeapps.ph/qr
RELEASE_BASE_URL=https://schooltesterp.orangeapps.ph/qr

# 3. School Theme & Appearance:
PRIMARY_COLOR=#083980

# 4. Remote Version & Maintenance Checker:
VERSION_CHECK_URL=https://storage.googleapis.com/oa-erp-app/rfid/version/version.json

# 5. Debug Base URL (used when running --debug):
DEBUG_BASE_URL=http://localhost/qr

# 6. Default Gate Configuration:
DEFAULT_BRANCH=schooltesterp
DEFAULT_GATE_ID=1
DEFAULT_GATE_NAME=Main Gate

# 7. RFID Tap Endpoint Mode:
TAP_ENDPOINT=save_rfid_entry

# 8. School Logo Image URL (Optional override - automatically discovered online):
SCHOOL_LOGO_URL=
