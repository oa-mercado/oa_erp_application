# ==============================================================
# OrangeApps RFID Kiosk (Student Attendance) - .env Template
# ==============================================================
# To use: Copy this file's contents into `.env`
# Command: cp .env.example.rfid .env (or copy .env.example.rfid .env)

# 1. App Identity / Display Name:
APP_NAME=OrangeApps RFID Kiosk

# 2. Release Base URL:
# Points to the school's /qr portal.
# The branch name (e.g. dominicanstarosa, esps, cdsa) is automatically detected from this URL.
# Examples:
#   RELEASE_BASE_URL=https://schooltesterp.orangeapps.ph/qr
#   RELEASE_BASE_URL=https://dominicanstarosaerp.orangeapps.ph/qr
RELEASE_BASE_URL=https://schooltesterp.orangeapps.ph/qr

# 3. School Theme & Appearance:
# Primary/background color in Hex format (#RRGGBB). Defaults to #083980.
# Note: Theme color and logo are automatically discovered from ERP when online.
PRIMARY_COLOR=#083980

# 4. Remote Version & Maintenance Checker:
VERSION_CHECK_URL=https://storage.googleapis.com/oa-erp-app/rfid/version/version.json

# 5. Debug Base URL (used when running --debug or without --release):
DEBUG_BASE_URL=http://localhost/qr

# 6. Default Gate Configuration:
DEFAULT_BRANCH=schooltesterp
DEFAULT_GATE_ID=1
DEFAULT_GATE_NAME=Main Gate

# 7. RFID Tap Endpoint Mode:
# For Student Kiosk: save_rfid_entry or student_entry
TAP_ENDPOINT=save_rfid_entry

# 8. School Logo Image URL (Optional override - automatically discovered online):
SCHOOL_LOGO_URL=
