# ==============================================================
# OrangeApps RFID Kiosk - Environment Configuration
# ==============================================================

# 1. Release Base URL:
# Change this URL and PRIMARY_COLOR for each school release.
# The branch name (e.g. schooltesterp, esps, cdsa) is automatically detected from this URL!
# Examples:
#   RELEASE_BASE_URL=https://schooltesterp.orangeapps.ph/qr
#   RELEASE_BASE_URL=https://espserp.orangeapps.ph/qr
#   RELEASE_BASE_URL=https://cdsaerp.orangeapps.ph/qr
RELEASE_BASE_URL=https://schooltesterp.orangeapps.ph/qr

# 2. School Theme & Appearance:
# Background color in Hex format (#RRGGBB). Defaults to #610303 (ESPS Maroon).
PRIMARY_COLOR=#610303

# 3. Remote Version & Maintenance Checker:
# Single JSON file hosted on Google Cloud Storage for all schools.
VERSION_CHECK_URL=https://storage.googleapis.com/oa-erp-app/rfid/version/version.json

# 4. Debug Base URL (used when running --debug):
DEBUG_BASE_URL=http://localhost/qr

# 5. Default Gate Configuration:
DEFAULT_BRANCH=la_salle_greenhills
DEFAULT_GATE_ID=1
DEFAULT_GATE_NAME=scholastica

# 6. RFID Tap Endpoint Mode:
# Options: student_entry (or /student_entry) OR save_rfid_entry (or /save_rfid_entry)
TAP_ENDPOINT=save_rfid_entry
