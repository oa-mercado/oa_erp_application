# ==============================================================
# OrangeApps HRIS Desktop Attendance - .env Template
# ==============================================================
# To use: Copy this file's contents into `.env`
# Command: cp .env.example.hris .env (or copy .env.example.hris .env)

# 1. App Identity / Display Name:
APP_NAME=OrangeApps HRIS Attendance

# 2. Release Base URL:
# Points to the school's /hris portal.
# Supports schools with passcode (e.g. dominicanstarosaerp) or without passcode (e.g. schooltesterp).
# Examples:
#   RELEASE_BASE_URL=https://schooltesterp.orangeapps.ph/hris/
#   RELEASE_BASE_URL=https://dominicanstarosaerp.orangeapps.ph/hris/
RELEASE_BASE_URL=https://schooltesterp.orangeapps.ph/hris/

# 3. School Theme & Appearance:
# Background color in Hex format (#RRGGBB). Defaults to #083980.
# Note: Theme color and logo are dynamically scraped from `<online-attendance ... />` when online!
PRIMARY_COLOR=#083980

# 4. Remote Version & Maintenance Checker:
VERSION_CHECK_URL=https://storage.googleapis.com/oa-erp-app/hris/version/version.json

# 5. Debug Base URL (used when running --debug or without --release):
DEBUG_BASE_URL=http://localhost/hris

# 6. Default Gate Configuration:
DEFAULT_BRANCH=schooltesterp
DEFAULT_GATE_ID=0
DEFAULT_GATE_NAME=HRIS Online Attendance

# 7. RFID Tap Endpoint Mode:
# For HRIS Employee Attendance: submit_attendance_by_id
TAP_ENDPOINT=submit_attendance_by_id

# 8. School Logo Image URL (Optional override - automatically discovered online):
SCHOOL_LOGO_URL=
